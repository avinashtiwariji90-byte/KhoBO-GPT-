PROJECT_NAME="ORA GPT"

# SECURITY — Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="CHANGE_ME_generate_a_real_secret_key_before_production"

# DATABASE — Use PostgreSQL in production
# Production example: postgresql+asyncpg://user:password@host:5432/oragpt
DATABASE_URL="sqlite+aiosqlite:///./ora_gpt.db"

# CORS — list your frontend URLs
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# FILE UPLOADS
UPLOAD_DIR="./uploads"

# AI Provider Keys (at least one recommended)
# Groq is FREE: https://console.groq.com
GROQ_API_KEY=""
# OpenAI (optional): https://platform.openai.com
OPENAI_API_KEY=""
# Google Gemini (optional): https://aistudio.google.com
GEMINI_API_KEY=""
